PORT=3004

# Slack app secrets. Socket Mode requires the xapp and xoxb tokens.
SLACK_SIGNING_SECRET=
SLACK_APP_TOKEN=xapp-...
SLACK_BOT_TOKEN=xoxb-...

# Configure one model provider.
ANTHROPIC_API_KEY=sk-...
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=

# X OAuth 1.0a user-context credentials. Reads always use the live X API.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Safe by default. Set to 0 only for an explicitly approved live-X test.
X_DRY_RUN=1

# Draft cards expire after five minutes by default.
# APPROVAL_TIMEOUT_MS=300000

# Optional model overrides.
# INTX_PROVIDER=anthropic
# INTX_MODEL=claude-sonnet-4-6
